# ─────────────────────────────────────────────────────────────
# DG Window CRM — Sandbox environment (placeholders only)
# Copy to `.env.local` and fill in real values ONLY for a
# dedicated, NON-production sandbox project. Never point this at
# an existing production database or reuse production secrets.
# ─────────────────────────────────────────────────────────────

# Sandbox flags — keep these as-is for a safe local sandbox.
# When SANDBOX_MODE is true and external integrations are disabled,
# the app never sends email/SMS/webhooks or calls third-party APIs.
NEXT_PUBLIC_SANDBOX_MODE=true
NEXT_PUBLIC_ENABLE_EXTERNAL_INTEGRATIONS=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Address autocomplete (§4) — provider + key are placeholders only. The
# sandbox works without a key; the field simply falls back to manual entry.
NEXT_PUBLIC_ADDRESS_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email provider (§8/§10) — placeholders only. In sandbox mode no email is
# actually sent; notifications are recorded in the in-app outbox instead.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# Website lead intake webhook (§12) — shared secret for POST /api/leads.
# Leave BLANK in the sandbox (no secret required). When set, callers must send
# a matching `x-webhook-secret` header or the request is rejected with 401.
WEBSITE_WEBHOOK_SECRET=

# Supabase (OPTIONAL — the sandbox runs fully in local empty-state
# mode without any Supabase connection). Use a brand-new, isolated
# Supabase project if you choose to connect one. Do NOT reuse any
# existing project URL, anon key, or service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-sandbox-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-sandbox-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-sandbox-service-role-key

# ─────────────────────────────────────────────────────────────
# Future integrations — all DISABLED in sandbox mode.
# These are placeholders only. Do not add real credentials while
# NEXT_PUBLIC_ENABLE_EXTERNAL_INTEGRATIONS=false.
# ─────────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GOOGLE_BUSINESS_API_KEY=
