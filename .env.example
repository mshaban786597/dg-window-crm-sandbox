# ─────────────────────────────────────────────────────────────
# DG Window CRM — environment template (PLACEHOLDERS ONLY)
#
# Copy to `.env.local` and put real values THERE. `.env.local` is git-ignored;
# this file is committed, so it must never contain a real credential.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=

# Public browser key. Supply EITHER the current publishable key OR the legacy
# anon key — the app accepts both (src/lib/supabase/env.ts). One is enough;
# do not duplicate the same value into both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-side secret — NEVER expose to the browser ──────────
# Required for migrations, the platform-admin bootstrap and privileged server
# routines. Supply EITHER name; the code accepts both. No NEXT_PUBLIC_ prefix,
# so Next.js cannot inline it into the client bundle.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Platform Super Admin ─────────────────────────────────────
# The single address allowed to be promoted to platform_super_admin.
# The bootstrap command refuses every other email and refuses unverified users.
PLATFORM_ADMIN_EMAIL=
# Optional UI hint only — not a security control.
NEXT_PUBLIC_PLATFORM_ADMIN_EMAIL=

# ── App URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mode ─────────────────────────────────────────────────────
# true  = non-production localStorage sandbox (no real auth; NOT a security boundary)
# false = real Supabase auth + row-level security
NEXT_PUBLIC_SANDBOX_MODE=false
NEXT_PUBLIC_ENABLE_EXTERNAL_INTEGRATIONS=false

# ── Address autocomplete (optional) ──────────────────────────
# Without a key the address field falls back to manual entry.
NEXT_PUBLIC_ADDRESS_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Email (optional) ─────────────────────────────────────────
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# ── Website lead intake (optional) ───────────────────────────
# When set, POST /api/leads requires a matching `x-webhook-secret` header.
WEBSITE_WEBHOOK_SECRET=

# ── Future integrations — disabled by default ────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GOOGLE_BUSINESS_API_KEY=
